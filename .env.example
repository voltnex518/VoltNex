# VoltNex Environment Configuration Example
# Copy this file to .env and configure your Supabase project credentials.

# Supabase Project URL (found in Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous or Publishable Key (found in Supabase Dashboard > Settings > API)
# Supports both JWT anon key (eyJ...) and publishable key format (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder

# Demo Data Fallback:
# Set to 'false' in production so the application connects directly to your live Supabase database.
# Set to 'true' only if you want an offline demo store without Supabase connectivity.
VITE_ENABLE_DEMO_DATA=false

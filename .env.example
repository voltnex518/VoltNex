# VoltNex Environment Configuration Example
# Copy this file to .env and configure your Supabase project credentials.

# Supabase Project URL (found in Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (found in Supabase Dashboard > Settings > API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder

# Demo Data Fallback: When set to 'true', enables offline mock data store
# when Supabase URL is placeholder or unconfigured, ensuring the application
# is 100% interactively testable out of the box in local development.
VITE_ENABLE_DEMO_DATA=true
